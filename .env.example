# 이 파일을 복사해서 .env 로 만들어 쓰세요. .env 는 절대 커밋하지 않습니다.
# cp .env.example .env

# --- 앱 ---
PORT=4000
# 서버에서 앱을 노출할 호스트 포트 (docker compose 전용)
APP_PORT=80

# --- DB (docker compose의 postgres를 쓸 때) ---
POSTGRES_USER=moeum
POSTGRES_PASSWORD=
POSTGRES_DB=moeum
# 컨테이너끼리는 서비스명(db)으로 통신한다
DATABASE_URL=postgresql://moeum:여기에_POSTGRES_PASSWORD@db:5432/moeum

# --- 인증 ---
# openssl rand -base64 48 로 생성
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
